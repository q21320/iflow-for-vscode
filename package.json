{
  "name": "Niren-for-vscode",
  "publisher": "i吃肉的77",
  "displayName": "Niren for VS Code",
  "description": "Bring Niren (niren CLI) into VS Code: chat panel, commands, and editor-group lock.",
  "version": "0.1.6",
  "repository": "https://github.com/xsw632/iflow-for-vscode.git",
  "homepage": "https://github.com/xsw632/iflow-for-vscode",
  "bugs": {
    "url": "https://github.com/xsw632/iflow-for-vscode/issues"
  },
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "iflow",
    "ai",
    "chat",
    "assistant"
  ],
  "icon": "media/iflow_icon.png",
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "iflow-for-vscode.openPanel",
        "title": "Niren: Open Panel",
        "icon": {
          "light": "media/iflow_favicon.svg",
          "dark": "media/iflow_favicon.svg"
        }
      },
      {
        "command": "iflow-for-vscode.lockGroup",
        "title": "Niren: Lock Editor Group",
        "icon": "$(lock)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "iflow-container",
          "title": "Niren",
          "icon": "media/iflow_favicon.svg"
        }
      ],
      "secondarySidebar": [
        {
          "id": "iflow-container-secondary",
          "title": "Niren",
          "icon": "media/iflow_favicon.svg"
        }
      ]
    },
    "views": {
      "iflow-container": [
        {
          "type": "webview",
          "id": "iflow-sidebar",
          "name": "Niren",
          "icon": "media/iflow_favicon.svg"
        }
      ],
      "iflow-container-secondary": [
        {
          "type": "webview",
          "id": "iflow-sidebar-secondary",
          "name": "Niren",
          "icon": "media/iflow_favicon.svg"
        }
      ]
    },
    "menus": {
      "editor/title": [
        {
          "command": "iflow-for-vscode.openPanel",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Niren",
      "properties": {
        "iflow.nodePath": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "description": "Node.js 可执行文件路径（v22 及以上版本）。若你的默认 Node 版本过低，则为必填项。示例：~/.nvm/versions/node/v22.0.0/bin/node"
        },
        "iflow.baseUrl": {
          "type": [
            "string",
            "null"
          ],
          "default": "http://192.155.1.141:11434/v1",
          "description": "可选的 OpenAI 兼容 API 终端点基础 URL。仅在需要覆盖 OpenAI 兼容 API 终端点时设置。示例：http://192.155.1.141:11434/v1). Only set this if you need the extension to override the CLI's configured endpoint."
        },
        "iflow.oauthClientId": {
          "type": "string",
          "default": "10009311001",
          "description": "PKCE 公共客户端 ID，用于登录。"
        },
        "iflow.oauthRequestTimeoutMs": {
          "type": "number",
          "default": 10000,
          "description": "OAuth HTTPS 请求（令牌交换、刷新及用户信息获取）的超时时间，单位为毫秒。"
        },
        "iflow.port": {
          "type": "number",
          "default": 8090,
          "description": "Niren  CLI WebSocket 服务器端口。"
        },
        "iflow.timeout": {
          "type": "number",
          "default": 60000,
          "description": "连接超时时间，单位为毫秒。"
        },
        "iflow.enableCliStream": {
          "type": "boolean",
          "default": true,
          "description": "使用 --stream 参数启动 Niren  CLI 以获取增量响应片段。仅当你的命令行界面 / 运行环境存在兼容性问题时，才禁用该参数。"
        },
        "iflow.interactionTimeoutMs": {
          "type": "number",
          "default": 120000,
          "description": "待处理的权限 / 问题 / 计划交互超时时间（单位：毫秒）。"
        },
        "iflow.maxFileBytes": {
          "type": "number",
          "default": 80000,
          "description": "最大文件大小（字节）用于附加文件"
        },
        "iflow.autoIncludeWorkspaceFiles": {
          "type": "boolean",
          "default": false,
          "description": "是否在每个提示中包含工作空间文件列表。默认禁用，以获得更快的第一个令牌延迟。"
        },
        "iflow.workspaceFilesLimit": {
          "type": "number",
          "default": 80,
          "description": "当启用niren.autoIncludeWorkspaceFiles时，包含的工作空间文件数量的上限。"
        },
        "iflow.streamRenderIntervalMs": {
          "type": "number",
          "default": 50,
          "description": "流式界面刷新间隔（单位：毫秒）。数值越小，界面越流畅，但会占用更多 CPU 资源；数值越大，CPU 占用越低，但界面更新频率也会降低。推荐范围：30-200 毫秒。"
        },
        "iflow.debugLogging": {
          "type": "boolean",
          "default": false,
          "description": "是否启用调试日志记录。"
        },
        "iflow.debugSessionUpdateOnly": {
          "type": "boolean",
          "default": false,
          "description": "是否在调试日志记录启用时，是否仅显示会话更新摘要日志（包含工具调用 ID）。在 Niren  输出通道中显示。"
        },
        "iflow.subagentInactivityTimeoutMs": {
          "type": "number",
          "default": 300000,
          "description": "子代理不活动检测超时时间（单位：毫秒）。如果在工具调用期间没有收到 Niren 的通知，则操作将被取消并通知主代理。默认值：300000（300 秒）。设置为 0 以禁用。"
        },
        "iflow.models": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": ["qwen3.5:0.8b"],
          "description": "可用模型列表。"
        },
        "iflow.modelContextSizes": {
          "type": "object",
          "default": {"qwen3.5:0.8b": 256000},
          "description": "每个模型的上下文窗口大小。"
        },
        "iflow.modelIdMap": {
          "type": "object",
          "default": {"qwen3.5:0.8b": "qwen3.5:0.8b"},
          "description": "模型 ID 映射。"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test:unit": "npm run compile-tests && mocha --ui tdd --require ./test/unit/vscode-shim.js \"out/test/**/*.test.js\"",
    "test:real-cli": "node scripts/run-real-cli-unit-test.mjs",
    "test:coverage": "npm run compile-tests && c8 --reporter=text --reporter=json-summary mocha --ui tdd --require ./test/unit/vscode-shim.js \"out/test/**/*.test.js\"",
    "coverage:check": "npm run test:coverage && node scripts/check-coverage.mjs",
    "test": "vscode-test",
    "vspackage": "vsce package"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.82.0",
    "@types/ws": "^8.5.13",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "c8": "^9.1.0",
    "eslint": "^9.39.2",
    "mocha": "^11.7.4",
    "path-browserify": "^1.0.1",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.52.0",
    "webpack": "^5.104.1",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "@iflow-ai/iflow-cli": "^0.5.18",
    "ws": "^8.18.0"
  }
}
