{
  "name": "Niren-for-vscode",
  "publisher": "YauMike",
  "displayName": "Niren for VS Code",
  "description": "Bring Niren (niren CLI) into VS Code: chat panel, commands, and editor-group lock.",
  "version": "0.1.6",
  "repository": "https://github.com/xsw632/iflow-for-vscode.git",
  "homepage": "https://github.com/xsw632/iflow-for-vscode",
  "bugs": {
    "url": "https://github.com/xsw632/iflow-for-vscode/issues"
  },
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "iflow",
    "ai",
    "chat",
    "assistant"
  ],
  "icon": "media/iflow_icon.png",
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "iflow-for-vscode.openPanel",
        "title": "Niren: Open Panel",
        "icon": {
          "light": "media/iflow_favicon.svg",
          "dark": "media/iflow_favicon.svg"
        }
      },
      {
        "command": "iflow-for-vscode.lockGroup",
        "title": "Niren: Lock Editor Group",
        "icon": "$(lock)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "iflow-container",
          "title": "Niren",
          "icon": "media/iflow_favicon.svg"
        }
      ],
      "secondarySidebar": [
        {
          "id": "iflow-container-secondary",
          "title": "Niren",
          "icon": "media/iflow_favicon.svg"
        }
      ]
    },
    "views": {
      "iflow-container": [
        {
          "type": "webview",
          "id": "iflow-sidebar",
          "name": "Niren",
          "icon": "media/iflow_favicon.svg"
        }
      ],
      "iflow-container-secondary": [
        {
          "type": "webview",
          "id": "iflow-sidebar-secondary",
          "name": "Niren",
          "icon": "media/iflow_favicon.svg"
        }
      ]
    },
    "menus": {
      "editor/title": [
        {
          "command": "iflow-for-vscode.openPanel",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Niren",
      "properties": {
        "iflow.nodePath": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "description": "Path to the Node.js executable (v22+). Required if your default Node version is too old. Example: ~/.nvm/versions/node/v22.0.0/bin/node"
        },
        "iflow.baseUrl": {
          "type": [
            "string",
            "null"
          ],
          "default": "http://192.155.1.141:11434/v1",
          "description": "Optional base URL for the OpenAI-compatible API endpoint (e.g. http://192.155.1.141:11434/v1). Only set this if you need the extension to override the CLI's configured endpoint."
        },
        "iflow.oauthClientId": {
          "type": "string",
          "default": "10009311001",
          "description": "OAuth client id used for iFlow login (PKCE public client)."
        },
        "iflow.oauthRequestTimeoutMs": {
          "type": "number",
          "default": 10000,
          "description": "Timeout in milliseconds for OAuth HTTPS requests (token exchange, refresh, and user info)."
        },
        "iflow.port": {
          "type": "number",
          "default": 8090,
          "description": "Port for iFlow CLI WebSocket server"
        },
        "iflow.timeout": {
          "type": "number",
          "default": 60000,
          "description": "Connection timeout in milliseconds"
        },
        "iflow.enableCliStream": {
          "type": "boolean",
          "default": true,
          "description": "Start iFlow CLI with --stream for incremental response chunks. Disable only if your CLI/runtime has compatibility issues."
        },
        "iflow.interactionTimeoutMs": {
          "type": "number",
          "default": 120000,
          "description": "Timeout in milliseconds for pending permission/question/plan interactions."
        },
        "iflow.maxFileBytes": {
          "type": "number",
          "default": 80000,
          "description": "最大文件大小（字节）用于附加文件"
        },
        "iflow.autoIncludeWorkspaceFiles": {
          "type": "boolean",
          "default": false,
          "description": "是否在每个提示中包含工作空间文件列表。默认禁用，以获得更快的第一个令牌延迟。"
        },
        "iflow.workspaceFilesLimit": {
          "type": "number",
          "default": 80,
          "description": "当启用iflow.autoIncludeWorkspaceFiles时，包含的工作空间文件数量的上限。"
        },
        "iflow.streamRenderIntervalMs": {
          "type": "number",
          "default": 50,
          "description": "Streaming UI refresh interval in milliseconds. Lower values feel smoother but use more CPU; higher values reduce CPU use but update less frequently. Recommended range: 30-200ms."
        },
        "iflow.debugLogging": {
          "type": "boolean",
          "default": false,
          "description": "Enable debug logging"
        },
        "iflow.debugSessionUpdateOnly": {
          "type": "boolean",
          "default": false,
          "description": "Only show [ACP] session/update summary logs (with toolCallId) in the IFlow output channel (and debug console when debugLogging is enabled)."
        },
        "iflow.subagentInactivityTimeoutMs": {
          "type": "number",
          "default": 300000,
          "description": "Timeout in milliseconds for sub-agent inactivity detection. If no notifications arrive from the CLI for this duration during a tool call, the operation is cancelled and the main agent is informed. Set to 0 to disable. Default: 300000 (300 seconds)."
        },
        "iflow.models": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": ["qwen3.5:0.8b"],
          "description": "List of available models"
        },
        "iflow.modelContextSizes": {
          "type": "object",
          "default": {"qwen3.5:0.8b": 256000},
          "description": "Context window sizes per model"
        },
        "iflow.modelIdMap": {
          "type": "object",
          "default": {"qwen3.5:0.8b": "qwen3.5:0.8b"},
          "description": "Model ID mapping"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test:unit": "npm run compile-tests && mocha --ui tdd --require ./test/unit/vscode-shim.js \"out/test/**/*.test.js\"",
    "test:real-cli": "node scripts/run-real-cli-unit-test.mjs",
    "test:coverage": "npm run compile-tests && c8 --reporter=text --reporter=json-summary mocha --ui tdd --require ./test/unit/vscode-shim.js \"out/test/**/*.test.js\"",
    "coverage:check": "npm run test:coverage && node scripts/check-coverage.mjs",
    "test": "vscode-test",
    "vspackage": "vsce package"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.82.0",
    "@types/ws": "^8.5.13",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "c8": "^9.1.0",
    "eslint": "^9.39.2",
    "mocha": "^11.7.4",
    "path-browserify": "^1.0.1",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.52.0",
    "webpack": "^5.104.1",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "@iflow-ai/iflow-cli": "^0.5.18",
    "ws": "^8.18.0"
  }
}
